# Template only — run scripts/generate-secrets.sh to create a real .env with random values.
# Never commit .env. All values below are placeholders.

PUBLIC_BASE_URL=https://localhost
APP_UID=1000
APP_GID=1000
HTTPS_PORT=443
HTTP_PORT=80
LOG_LEVEL=info
SEED_DEMO_DATA=true

POSTGRES_DB=ciso
POSTGRES_USER=ciso_owner
POSTGRES_PASSWORD=<generated>
APP_DB_PASSWORD=<generated>
KC_DB_PASSWORD=<generated>

KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generated>
OIDC_CLIENT_SECRET=<generated>
DEMO_USER_PASSWORD=<generated>

# Active AES-256 key id within secrets/data_encryption_keys ("v1:<b64>,v2:<b64>")
DATA_ENCRYPTION_ACTIVE_KEY=v1

# Secrets provider for the API: env (files / env vars) | vault (HashiCorp Vault KV v2)
SECRETS_PROVIDER=env
# VAULT_ADDR=https://vault.corp.example:8200
# VAULT_KV_MOUNT=secret
# VAULT_KV_PATH=ciso-dashboard

# Connector egress policy
CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_BLOCK_PRIVATE_NETWORKS=false

# Optional read replicas (multi-cluster): comma-separated PostgreSQL URLs
# DATABASE_REPLICA_URLS=

# Demo profile (SEED_DEMO_DATA=true): demo administrator created by idp-init.
# Its password is stored in secrets/demo_admin_password (default Admin@123!).
DEMO_ADMIN_USERNAME=admin

# Deployment profile — normally written by scripts/apply-deployment.sh from
# Configuration → Deployment (public URL / IP, certificate names, load balancers…)
CERT_SANS=localhost
TRUSTED_UPSTREAM_PROXIES=
EDGE_RATE_LIMIT_RPS=50
EDGE_AUTH_RATE_LIMIT_RPS=20
API_MEMORY=1024m
KEYCLOAK_MEMORY=1536m
POSTGRES_MEMORY=2048m
