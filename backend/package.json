{
  "name": "ciso-dashboard-api",
  "version": "1.0.0",
  "private": true,
  "description": "CISO Executive Dashboard - secure API service",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.2.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "openid-client": "^5.7.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.16.0",
    "undici": "^7.8.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
